{
  "name": "butter",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "catalog": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check",
    "format": "biome check --write",
    "knip": "knip",
    "check": "bun run lint && bun run typecheck && bun run knip && bun run build",
    "prepare": "[ -n \"$CI\" ] || lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "typescript": "catalog:"
  }
}
